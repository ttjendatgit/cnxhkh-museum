# Copy to `.env.local` (git-ignored) and fill in the values of your Firebase web app:
# Firebase console -> Project settings -> General -> Your apps -> SDK setup and configuration.
# While these are unset, the Final Room game runs on the local mock backend.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
# Realtime Database URL, e.g. https://<project>-default-rtdb.<region>.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: the competition's room id (gameRooms/{roomId}); the URL's ?room= wins. Default: main
# VITE_FINAL_GAME_ROOM_ID=main

# Optional: operator PIN for the admin console (required when Firebase is used)
# VITE_FINAL_GAME_ADMIN_PIN=
